flowchart TB
  subgraph IN["SPECS"]
    direction LR
    C["Claude CTO<br/>design, contracts, specs"] ~~~ O["Owner<br/>specs and approvals"]
  end
  subgraph GW["AGENT RISK + COST GATEWAY · SHARED MODULE"]
    direction LR
    G1["Pinned design<br/>hash-checked"] ~~~ G2["Every message<br/>mask · injection · size cap"] ~~~ G3["Allowed actions only<br/>no push · no remotes<br/>no test deletion"] ~~~ G4["Limits + credit plan<br/>rounds · minutes · calls"]
  end
  subgraph LANES["CODER LANES · SUBSCRIPTION ONLY"]
    direction LR
    L1["Codex CLI<br/>builder"] <-.->|"builder ⇄ reviewer"| L2["Claude Code CLI<br/>builder or reviewer"]
  end
  VR["Verify, never trust the report<br/>committed · remotes unchanged · diff guard · full tests re-run"]
  V{"Gates pass?"}
  OUT["outbox patches + REPORT.md<br/>one status page"]
  H["Owner reviews<br/>merge by pull request"]
  F["Fix once, then roll back<br/>lane stops"]
  Q["Design question<br/>human decides"]
  IN --> GW --> LANES --> VR --> V
  V -->|"pass"| OUT --> H
  V -->|"fail"| F
  GW -.->|"design drift"| Q
