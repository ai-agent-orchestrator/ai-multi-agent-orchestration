flowchart TB
    subgraph Development["DEVELOPMENT WORKFLOW"]
        direction LR
        Owner["Owner<br/>Decisions and Prompt Review"]
        Google["Google AI Mode<br/>Broad, Current Research"]
        Claude["Claude<br/>Harness Design, Review<br/>and Verification"]
        Codex["Codex<br/>Coder<br/>Implements Specs, Nightly Runs"]
        Owner -->|"Approves research packs"| Google
        Google -->|"Findings"| Claude
        Claude -->|"Specs and Contracts"| Codex
        Owner -.->|"Confirms decisions"| Claude
    end

    Codex -.-> Spring

    subgraph Runtime["RUNTIME DESIGN"]
        direction TB
        Spring["Spring Boot Control Plane<br/>Authorization, Policy and Cost Ledger"]
        Python["Python FastAPI Orchestrator<br/>Dispatch, Concurrency and Budget"]
        Mask["Masking and Injection Checks<br/>Own code, before any model"]
        InputRails["NVIDIA NeMo Guardrails - planned<br/>Input Content Checks"]
        Queue["Task Queue<br/>Bounded Jobs and Retries"]
        Memory["memvid Memory<br/>Authorized, Source-Linked Evidence"]
        Sandbox["NVIDIA NemoClaw / OpenShell - planned<br/>Supported Agent + Tool Sandbox"]
        subgraph Workers["EXECUTION WORKERS"]
            direction LR
            W1["Local Small Model<br/>Classify and Tag"]
            W2["Approved Cloud Model<br/>Research and Verification"]
        end
        Validate["Validation and Usage Accounting<br/>Results, Trace and Cost"]
        OutputRails["NVIDIA NeMo Guardrails - planned<br/>Output Content Checks"]
        Spring --> Python --> Mask --> InputRails -->|"Allowed"| Queue
        Queue --> Memory
        Memory --> W1
        Memory --> W2
        Queue -.->|"Agent Tasks Only"| Sandbox
        Sandbox -.-> W2
        W1 --> OutputRails
        W2 --> OutputRails
        OutputRails -->|"Allowed"| Validate
    end

