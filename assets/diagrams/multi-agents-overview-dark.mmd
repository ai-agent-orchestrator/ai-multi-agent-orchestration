flowchart TB
  subgraph OWN["TOP · OWNER + DESIGN LOOP"]
    direction LR
    G["Google AI Mode<br/>broad, current research"] -->|"findings"| C["Claude<br/>CTO: design, specs, verification"]
    O["Owner<br/>decisions, review, merge"]
  end
  subgraph AG["MIDDLE · TWO MULTI-AGENT PRODUCTS ON ONE PC"]
    direction LR
    subgraph A1["MULTI-AGENT 1 · NIGHTCODER RELAY"]
      direction TB
      R1["Spec inbox<br/>lanes + scheduler"]
      R2["Codex / Claude Code<br/>coder CLIs"]
      R3["Gates + REPORT.md<br/>outbox, status page"]
      R1 --> R2 --> R3
    end
    subgraph A2["MULTI-AGENT 2 · DRAFT TO DONE + EDGE EQUALIZER"]
      direction TB
      D1["Feeds + 30-40 page<br/>AI chat drafts"]
      D2["Edge Equalizer<br/>vector + keyword search<br/>knob 1 spear · knob 2 shield"]
      D3["Llama brief, board<br/>AI Mode pack, alarms"]
      D1 --> D2 --> D3
    end
    D2 -.->|"extension:<br/>long-design brief"| R1
  end
  subgraph SH["BOTTOM · SHARED RISK + COST LAYER · ENFORCED BY CODE"]
    direction LR
    S1["Masking + leak scan"]
    S2["Injection checks<br/>untrusted text is data"]
    S3["Caps + budgets<br/>no extra payment"]
    S4["Human gates<br/>sensitive text, merge"]
  end
  C -->|"specs"| R1
  O -->|"approves packs"| D3
  A1 --> SH
  A2 --> SH
